{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 170
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "byte_end": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 18000
          },
          "attribution": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          }
        },
        "required": [
          "id",
          "source_index",
          "byte_start",
          "byte_end",
          "quote",
          "attribution"
        ]
      },
      "maxItems": 100
    },
    "phonemes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "symbol": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "grapheme": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "category": {
            "enum": [
              "vowel",
              "consonant",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "symbol",
          "grapheme",
          "category",
          "note"
        ]
      },
      "maxItems": 100
    },
    "lexemes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "part_of_speech": {
            "enum": [
              "noun",
              "verb",
              "adjective",
              "particle",
              "name"
            ]
          },
          "phoneme_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 256
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 30
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "meaning",
          "part_of_speech",
          "phoneme_ids",
          "evidence_ids",
          "note"
        ]
      },
      "maxItems": 300
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170
          },
          "kind": {
            "enum": [
              "prepend",
              "append",
              "replace"
            ]
          },
          "match_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 30
          },
          "replacement_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 30
          },
          "applies_to": {
            "type": "array",
            "items": {
              "enum": [
                "noun",
                "verb",
                "adjective",
                "particle",
                "name"
              ]
            },
            "maxItems": 5
          },
          "note": {
            "type": "string",
            "minLength": 0,
            "maxLength": 3000
          }
        },
        "required": [
          "id",
          "title",
          "kind",
          "match_ids",
          "replacement_ids",
          "applies_to",
          "note"
        ]
      },
      "maxItems": 100
    },
    "derivations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170
          },
          "lexeme_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "rule_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 30
          },
          "basis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "rule_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "phoneme_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "pattern": "^[A-Za-z0-9_-]+$"
                  },
                  "maxItems": 256
                },
                "text": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 12800
                }
              },
              "required": [
                "rule_id",
                "phoneme_ids",
                "text"
              ]
            },
            "maxItems": 30
          },
          "phoneme_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "maxItems": 256
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12800
          },
          "meaning": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "title",
          "lexeme_id",
          "rule_ids",
          "basis_sha256",
          "steps",
          "phoneme_ids",
          "text",
          "meaning"
        ]
      },
      "maxItems": 200
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 170
          },
          "tokens": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "lexeme",
                    "derivation"
                  ]
                },
                "ref_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z0-9_-]+$"
                },
                "gloss": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 500
                }
              },
              "required": [
                "kind",
                "ref_id",
                "gloss"
              ]
            },
            "maxItems": 100
          },
          "translation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "basis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "title",
          "tokens",
          "translation",
          "basis_sha256"
        ]
      },
      "maxItems": 100
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "target_kind": {
            "enum": [
              "lexeme",
              "rule",
              "derivation",
              "example"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 0,
            "maxLength": 5000
          }
        },
        "required": [
          "id",
          "target_kind",
          "target_id",
          "target_sha256",
          "origin",
          "comment",
          "status",
          "resolution"
        ]
      },
      "maxItems": 200
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_plugin_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "owner_plugin_id",
          "object_id",
          "revision",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "title",
    "brief",
    "evidence",
    "phonemes",
    "lexemes",
    "rules",
    "derivations",
    "examples",
    "notes",
    "basis_refs"
  ]
}
